# tpTwo 本地开发配置
#
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#
# 注意：.env 会**覆盖**终端里的同名环境变量，且复制会覆盖已有的 .env。
# 若你已有一份可用的 .env，不要重新复制这个文件。
#
# 生成口令哈希（输入不受 shell 转义影响，@ $ ! 等字符都能正常处理）：
#   cd backend
#   .venv\Scripts\python.exe -c "import hashlib,getpass;print(hashlib.sha256(getpass.getpass('密码: ').encode()).hexdigest())"
#
# 把输出的 64 位十六进制字符串粘到下面。ADMIN_PASSWORD_HASH 为空时后端
# 拒绝启动——这是刻意的，避免带着无效凭据跑起来。

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# 会话有效期（小时），默认 168 = 7 天
# AUTH_SESSION_TTL_HOURS=168

# 数据库路径；默认 backend/blog.db
# DATABASE_URL=sqlite:///./blog.db